<!DOCTYPE html>
<html>
<head>
	<title>Bookie Api</title>
	<link rel="icon" type="image/x-icon" href="/favicon.ico">
	<!------------ DM Sans-------------->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
	<style>
		body{
			font-family: "DM Sans", sans-serif;
			font-weight: 400;
			font-style: normal;
			background:#f9f9f9;
        }
        .accordion {
            --bs-accordion-border-color: #000;
            --bs-accordion-border-radius: 20px;
        }
        .accordion-item:first-of-type>.accordion-header .accordion-button {
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
        }
        .accordion-item:last-of-type>.accordion-header .accordion-button.collapsed {
            border-bottom-right-radius: 20px;
            border-bottom-left-radius: 20px;
        }
        .accordion-button:not(.collapsed) {
            color: #FFF;
            background-color: #000;
            box-shadow:none !important;
        }
        .accordion-button:focus {
            box-shadow:none !important;
        }
        .accordion-button:not(.collapsed)::after {
            filter: brightness(0) invert(1);
        }
        .wrap {
            width:800px;
            margin: 50px auto;
        }
        .green-text-13 {
            font-size: 13px;
            color: green;
            font-weight: 700;
        }
        .white-text-12 {
            font-size: 13px;
            color: #000;
            font-weight: 400;
            margin: 0 0 0 30px;
        }
        .white-text-12 span {
            color:#666;
        }
	</style>
</head>
<body>
    <div class="wrap">
        <div class="accordion" id="accordionPanelsStayOpenExample">
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="true" aria-controls="panelsStayOpen-collapseOne">
        <span class="badge text-bg-primary me-2"> post</span> /booking/add-category
      </button>
    </h2>
    <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show">
      <div class="accordion-body">
        <div>
                <div class="green-text-13">Request {</div>
                    <div class="white-text-12">categorytitle<span>(string)</span>: title,</div>
                    <div class="white-text-12">categorydescription<span>(string)</span>:description,</div>
                <div class="green-text-13">}</div>
           </div>
           <div class="mt-3">
                <div class="green-text-13">Response {</div>
                <div class="white-text-12">status:ok,</div>
                <div class="green-text-13">}</div>
            </div>
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseTwo" aria-expanded="false" aria-controls="panelsStayOpen-collapseTwo">
            <div class="title"><span class="badge text-bg-success me-2"> get</span> /booking/categories</div>
      </button>
    </h2>
    <div id="panelsStayOpen-collapseTwo" class="accordion-collapse collapse">
        <div class="accordion-body">
          <div class="green-text-13">Response {</div>
               <div class="white-text-12"> [</div>
                    <div class="white-text-12" style="margin-left:40px">{</div>
                       <div class="white-text-12" style="margin-left:50px"> _id:456789221,</div>
                        <div class="white-text-12" style="margin-left:50px">categoryid(number):1,</div>
                        <div class="white-text-12" style="margin-left:50px">categorytitle(string):"EYE",</div>
                        <div class="white-text-12" style="margin-left:50px">categorydescription(string):"EYE is important part of body",</div>
                    <div class="white-text-12" style="margin-left:40px">},</div>
                    <div class="white-text-12" style="margin-left:40px">{</div>
                       <div class="white-text-12" style="margin-left:50px"> _id:456789222,</div>
                       <div class="white-text-12" style="margin-left:50px"> categoryid(number):2,</div>
                       <div class="white-text-12" style="margin-left:50px"> categorytitle(string):"EAR",</div>
                        <div class="white-text-12" style="margin-left:50px">categorydescription(string):"",</div>
                    <div class="white-text-12" style="margin-left:40px">},</div>
               <div class="white-text-12"> ]</div>
            <div class="green-text-13">}</div>
        </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseThree" aria-expanded="false" aria-controls="panelsStayOpen-collapseThree">
        <div class="title"><span class="badge text-bg-success me-2"> get</span> /booking/category/id</div>
      </button>
    </h2>
    <div id="panelsStayOpen-collapseThree" class="accordion-collapse collapse">
      <div class="accordion-body">
        <div class="green-text-13">Response {</div>
            <div class="white-text-12"> _id:456789222,</div>
            <div class="white-text-12"> categoryid<span>(number)</span>:2,</div>
            <div class="white-text-12"> categorytitle<span>(string)</span>:"EAR",</div>
            <div class="white-text-12">categorydescription<span>(string)</span>:"",</div>
        <div class="green-text-13">}</div>      
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFour" aria-expanded="false" aria-controls="panelsStayOpen-collapseFour">
        <div class="title"><span class="badge text-bg-warning me-2"> put</span> /booking/edit-category/id</div>
      </button>
    </h2>
    <div id="panelsStayOpen-collapseFour" class="accordion-collapse collapse">
        <div class="accordion-body">
            <div>
                <div class="green-text-13">Request {</div>
                    <div class="white-text-12"> categoryid<span>(number)</span>:id,</div>
                    <div class="white-text-12"> categorytitle<span>(string)</span>:title,</div>
                    <div class="white-text-12">categorydescription<span>(string)</span>:description,</div>
                <div class="green-text-13">}</div>
            </div>
            <div class="mt-3">
                <div class="green-text-13">Response {</div>
                <div class="white-text-12">status:ok,</div>
                <div class="green-text-13">}</div>
            </div>
        </div>       
    </div>   
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header">
      <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#panelsStayOpen-collapseFive" aria-expanded="false" aria-controls="panelsStayOpen-collapseFive">
        <div class="title"><span class="badge text-bg-danger me-2"> delete</span> /booking/delete-category/id</div>
      </button>
    </h2>
    <div id="panelsStayOpen-collapseFive" class="accordion-collapse collapse">
        <div class="accordion-body">
            <div>
                <div class="green-text-13">Request {</div>
                    <div class="white-text-12"> categoryid<span>(number)</span>:id,</div>
                 <div class="green-text-13">}</div>
            </div>
            <div class="mt-3">
                <div class="green-text-13">Response {</div>
                <div class="white-text-12">status:ok,</div>
                <div class="green-text-13">}</div>
            </div>
        </div>       
    </div>   
  </div>
</div>
   
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>    